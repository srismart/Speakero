SMALLEST_API_KEY=your_smallest_ai_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (optional: without these the app runs anonymous-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_legacy_jwt_secret
# Debrief feedback persists to a session_feedback table when Supabase is
# configured (run docs/migrations/2026-08-03-session-feedback.sql); fail-open otherwise.
# Signed-in sessions persist to a sessions table (run docs/migrations/2026-08-03-sessions.sql).

# Comma-separated socket.io CORS allowlist; * (default) allows all origins (dev)
ALLOWED_ORIGINS=*

# Auto-stop after this many seconds without speech; 0 disables
SILENCE_TIMEOUT_SECONDS=180

# Voice provider selection; current options: pulse / smallest
STT_PROVIDER=pulse
TTS_PROVIDER=smallest
